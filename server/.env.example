# 운영 서버는 반드시 production. 이때 아래 두 비밀키가 없거나 약하면 서버·init-db가 시작하지 않는다.
NODE_ENV=production

# 로그인 토큰 서명 키. 32자 이상 무작위 값: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 민감정보(건강 정보·상담 내용·결제 주문서·Bridge 키) 암호화 키. 64자리 hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 이미 운영 중인 DB라면 새로 만들지 말고 `npm run security:check -- --print-legacy-data-key` 값을 넣는다. 잃어버리면 암호문을 복구할 수 없다.
DATA_ENCRYPTION_KEY=

# 첫 플랫폼 관리자(운영 DB에 활성 관리자가 없을 때 npm run init-db가 한 번만 만든다). 만든 뒤에는 지운다.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# 스테이징 서버에서만 true. 데모 VAN·데모 Bridge·데모 결제·결제사 테스트 키를 받는다. 운영 DB에는 켤 수 없다(docs/payment-test-policy.md).
# MAYDIN_STAGING=true

PORT=3001
